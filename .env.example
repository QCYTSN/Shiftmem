# Shared generation settings
# The CLI stays deterministic unless --provider is supplied explicitly.
MODEL_PROVIDER=bailian
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_TOKENS=512
MODEL_TEMPERATURE=0
MODEL_ENABLE_THINKING=false

# Alibaba Cloud Model Studio (Bailian)
# Formal Qwen override: qwen3.7-plus-2026-05-26
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL_NAME=qwen3.5-flash-2026-02-23

# SiliconFlow
# Structured GLM comparison override: Pro/zai-org/GLM-5.1
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL_NAME=deepseek-ai/DeepSeek-V3.2
